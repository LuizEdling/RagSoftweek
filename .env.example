# ============================================================
# RAG Lab — variáveis de ambiente do backend (backend/.env)
# Copie este arquivo para backend/.env e preencha com suas chaves.
# NUNCA coloque chaves reais neste arquivo .env.example nem em código.
# ============================================================

# --- Qdrant (banco vetorial) ---
# Padrão do projeto: "local" -> Qdrant embarcado (motor real de busca
# vetorial, sem servidor nem Docker), populado automaticamente no
# primeiro startup do backend em backend/.qdrant_local/. Bom para
# desenvolver e testar a integração real sem nenhuma conta.
#   QDRANT_URL=local:/caminho   -> persiste em um caminho customizado
#   QDRANT_URL=:memory:         -> efêmero, some ao reiniciar o processo
#
# Para o workshop (vários alunos acessando pela internet ao mesmo tempo),
# troque para um cluster gratuito em https://cloud.qdrant.io:
#   QDRANT_URL=https://xxxx.cloud.qdrant.io
#   QDRANT_API_KEY=sua-chave
#   (depois rode: python scripts/ingest.py)
#
# Deixe QDRANT_URL vazio para voltar ao modo mock (busca por palavra-chave,
# sem nenhum banco vetorial real).
QDRANT_URL=local
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_lab_documents

# --- Embeddings ---
# EMBEDDING_PROVIDER: mock | openai | cohere
# Em "mock", o sistema funciona sem nenhuma chave, com vetores simulados
# e busca por similaridade de palavras-chave (bom para testar a interface).
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Dimensão do vetor. Ajuste conforme o modelo escolhido:
#   OpenAI text-embedding-3-small -> 1536 (pode ser truncado)
#   Cohere embed-multilingual-v3.0 -> 1024
EMBEDDING_DIMENSIONS=768

# --- LLM ---
# LLM_PROVIDER: mock | groq | openai
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# --- Reranker ---
# RERANKER_MODE: heuristic (padrão, sem custo/API) | external (ex. Cohere Rerank)
RERANKER_MODE=heuristic
RERANKER_API_KEY=

# --- Limites e performance ---
TOP_K=5
RERANK_KEEP=2
RATE_LIMIT_PER_MINUTE=10
MAX_QUESTION_LENGTH=500
CACHE_ENABLED=true
CACHE_TTL_SECONDS=120

# --- CORS ---
# Domínio(s) do frontend em produção, separados por vírgula.
# Em desenvolvimento local pode deixar "*".
CORS_ORIGINS=*

# ============================================================
# Frontend (frontend/.env) — opcional
# Sem essa variável, o frontend roda 100% em modo mock no navegador.
# ============================================================
# VITE_API_URL=https://seu-backend.onrender.com
